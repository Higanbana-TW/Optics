# Copy to live-captions/.env if you want a file instead of system environment variables.
# Do not commit .env. Keys are optional and are not used unless you select that translator.

# local (default): offline OPUS-MT model, then OpenCC s2twp.
# deepl | openai | libre send the English line to that service.
CAPTIONS_TRANSLATOR=local

# loopback (default) listens to the default Windows playback device.
# mic listens to the microphone instead.
CAPTIONS_AUDIO=loopback

# Optional substring of the playback device name, for example Headphones.
# CAPTIONS_LOOPBACK_NAME=

CAPTIONS_WHISPER_MODEL=base.en
CAPTIONS_WHISPER_DEVICE=cpu
# CAPTIONS_WHISPER_COMPUTE=int8
CAPTIONS_CPU_THREADS=4
CAPTIONS_VAD_THRESHOLD=0.01
CAPTIONS_BAR_ALPHA=214

# Used only when CAPTIONS_TRANSLATOR=deepl. Free keys end with :fx.
# DEEPL_API_KEY=

# Used only when CAPTIONS_TRANSLATOR=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Used only when CAPTIONS_TRANSLATOR=libre.
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
